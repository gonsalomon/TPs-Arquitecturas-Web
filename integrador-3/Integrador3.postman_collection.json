    {
      "name": "f) Carreras con inscriptos",
      "description": "GET /carreras/carreras-inscriptos, ordenadas por cantidad de inscriptos.",
      "item": [
        {
          "name": "f) carreras con inscriptos ordenadas por cantidad (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y lista las carreras con inscriptos', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve nombre y cantidad de inscriptos', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(lista[0]).to.have.all.keys('nombre', 'cantidadInscriptos');",
                  "    pm.expect(lista[0].cantidadInscriptos).to.be.a('number');",
                  "});",
                  "pm.test('Viene ordenada por cantidad de inscriptos descendente', function () {",
                  "    const lista = pm.response.json();",
                  "    for (let i = 1; i < lista.length; i++) {",
                  "        pm.expect(lista[i - 1].cantidadInscriptos,",
                  "            'quedo desordenado en ' + lista[i - 1].nombre + ' / ' + lista[i].nombre",
                  "        ).to.be.at.least(lista[i].cantidadInscriptos);",
                  "    }",
                  "});",
                  "pm.test('TUDAI encabeza la lista (17 inscriptos en el CSV)', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista[0].nombre).to.eql('TUDAI');",
                  "});",
                  "pm.test('Ninguna carrera aparece con 0 inscriptos', function () {",
                  "    const lista = pm.response.json();",
                  "    lista.forEach(function (c) { pm.expect(c.cantidadInscriptos).to.be.above(0); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/carreras/carreras-inscriptos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carreras",
                "carreras-inscriptos"
              ]
            },
            "description": "Consigna f). Solo trae las carreras que tienen al menos un inscripto (es un JOIN) y las ordena por cantidad de inscriptos de mayor a menor."
          },
          "response": []
        },

                  "    pm.expect(b.idCarrera).to.eql(1);",
                  "    pm.expect(b.id).to.be.a('number');",
                  "});",
                  "pm.test('InscripcionService completa anio actual, graduacion 0 y antiguedad 1', function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b.anioInscripcion).to.eql(new Date().getFullYear());",
                  "    pm.expect(b.anioGraduacion).to.eql(0);",

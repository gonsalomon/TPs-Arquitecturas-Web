    {
      "name": "c) Todos los estudiantes",
      "description": "GET /estudiantes, ordenados por apellido y nombre.",
      "item": [
        {
          "name": "c) todos los estudiantes ordenados (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y lista los estudiantes', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve una lista no vacia de EstudianteDTO', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(lista[0]).to.have.all.keys('dni', 'nombre', 'apellido', 'edad', 'genero', 'ciudad', 'lu');",
                  "});",
                  "pm.test('La lista viene ordenada por apellido', function () {",
                  "    const lista = pm.response.json();",
                  "    // Se pasa todo a minusculas porque MySQL ordena sin distinguir",
                  "    // mayusculas, y se compara contra la misma lista ya ordenada.",
                  "    const apellidos = lista.map(function (e) { return e.apellido.toLowerCase(); });",
                  "    pm.expect(apellidos).to.eql(apellidos.slice().sort());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estudiantes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estudiantes"
              ]
            },
            "description": "Consigna c). GET /estudiantes devuelve todos los estudiantes ordenados por apellido ASC y, a igual apellido, por nombre ASC."
          },
          "response": []
        }
      ]
    },

            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 y matricula al estudiante', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('La inscripcion queda asociada al estudiante y a la carrera', function () {",
